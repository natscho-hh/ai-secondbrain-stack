      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "schluss",
      "x": 80,
      "y": 1500,
      "width": 1300,
      "height": 70,
      "text": "The one rule underneath all of it: information has exactly one home.\nEverything you see above is a consequence of that — the single rulebook, the generated\nmirrors, the project file that wins when the board disagrees with it.",
      "originalText": "The one rule underneath all of it: information has exactly one home.\nEverything you see above is a consequence of that — the single rulebook, the generated\nmirrors, the project file that wins when the board disagrees with it.",
      "fontSize": 16,
