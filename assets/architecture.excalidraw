    {
      "type": "text",
      "id": "skills_erklaerung",
      "x": 1180,
      "y": 950,
      "width": 900,
      "height": 130,
      "text": "Claude Code and Codex only discover skills from their own folder,\nso setup generates both as mirrors. Gemini CLI and OpenCode have\nno such folder and read skills/ directly, because the rulebook\ntells them to.\n\nFour core skills ship with the template: daily-note, inbox-triage,\nvault-health, vault-inventory. Third-party skills go through a\nsecurity gate first, one at a time, and land in skills/ so every\nagent can see them.",
      "originalText": "Claude Code and Codex only discover skills from their own folder,\nso setup generates both as mirrors. Gemini CLI and OpenCode have\nno such folder and read skills/ directly, because the rulebook\ntells them to.\n\nFour core skills ship with the template: daily-note, inbox-triage,\nvault-health, vault-inventory. Third-party skills go through a\nsecurity gate first, one at a time, and land in skills/ so every\nagent can see them.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 910031,
      "version": 1,
      "versionNonce": 910032,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "skills_falle",
      "x": 1180,
      "y": 1130,
      "width": 900,
      "height": 40,
      "text": "One formatting rule decides whether a skill is found at all:\nthe YAML frontmatter must start on line 1.",
      "originalText": "One formatting rule decides whether a skill is found at all:\nthe YAML frontmatter must start on line 1.",
