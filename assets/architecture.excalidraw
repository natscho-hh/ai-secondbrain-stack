    },
    {
      "type": "text",
      "id": "setup_hinweis",
      "x": 1560,
      "y": 250,
      "width": 900,
      "height": 110,
      "text": "How it gets there: SETUP.md\n\nAn agent-guided installer in seven phases. It interviews you,\nscaffolds or migrates the vault, writes the rulebook and its\nadapters, mirrors the skills, and proves the whole thing works\nbefore it hands over. Re-running it only ever adds.",
      "originalText": "How it gets there: SETUP.md\n\nAn agent-guided installer in seven phases. It interviews you,\nscaffolds or migrates the vault, writes the rulebook and its\nadapters, mirrors the skills, and proves the whole thing works\nbefore it hands over. Re-running it only ever adds.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#b45309",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
